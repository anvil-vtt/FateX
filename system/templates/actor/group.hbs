<div class="fatex-desk">
    <form autocomplete="off" class="fatex-group-form">
        <header class="fatex-header">
            <div class="fatex-header__name">
                <label class="fatex-header__label">{{localize "FAx.Sheet.Name"}}</label>
                <input class="fatex-text-input fatex-text-input--header" name="name" type="text" value="{{actor.name}}">
            </div>
            <img class="fatex-header__logo" src="systems/fatex/assets/logos/powered_by_fate.svg" alt="">
        </header>
        <div class="fatex-js-actor_group-settings fatex__actor_group__settings">
            <input name="system.groupType" type="text" value="{{system.groupType}}">
            {{#if availableTokens}}
                <div class="fatex__actor_group__availableTokens">
                    {{#each availableTokens}}
                        <div class="fatex__actor_group__createToken" data-action="createTokenReference" data-token-id="{{this._id}}">
                            <img width="48" src="{{this.img}}" alt="">
                            <span>{{this.name}}</span>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
        </div>
    </form>
    <div class="fatex-js-actor-group-sheets fatex-desk__content fatex-desk__content--group"></div>
</div>
