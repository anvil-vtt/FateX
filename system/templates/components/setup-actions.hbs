<div class="fatex-setup-actions">
    <span class="fatex-js-clear-aspects fatex-button fatex-button--light{{#unless hasAspects}} fatex-u-disabled{{/unless}}" data-action="clearAspects">
        {{localize "FAx.Apps.Setup.Actions.Clear.Aspects"}}
    </span>

    <span class="fatex-js-clear-consequences fatex-button fatex-button--light{{#unless hasConsequences}} fatex-u-disabled{{/unless}}" data-action="clearConsequences">
        {{localize "FAx.Apps.Setup.Actions.Clear.Consequences"}}
    </span>

    <span class="fatex-js-clear fatex-button fatex-button--clear-all{{#unless hasAny}} fatex-u-disabled{{/unless}}" data-action="clearAll">
        <i class="fa fa-skull-crossbones"></i>
        <span>{{localize "FAx.Apps.Setup.Actions.Clear.Everything"}}</span>
    </span>

    <span class="fatex-js-clear-skills fatex-button fatex-button--light{{#unless hasSkills}} fatex-u-disabled{{/unless}}" data-action="clearSkills">
        {{localize "FAx.Apps.Setup.Actions.Clear.Skills"}}
    </span>

    <span class="fatex-js-clear-stress fatex-button fatex-button--light{{#unless hasStress}} fatex-u-disabled{{/unless}}" data-action="clearStress">
        {{localize "FAx.Apps.Setup.Actions.Clear.Stress"}}
    </span>
</div>
